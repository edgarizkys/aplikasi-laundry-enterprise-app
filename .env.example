# Database
DATABASE_URL=file:local.db
TURSO_CONNECTION_URL=libsql://your-database-name-xxxx.turso.io
TURSO_AUTH_TOKEN=your_auth_token_here

# Server
PORT=3000
NODE_ENV=development
HOST=localhost

# API Configuration
API_BASE_URL=http://localhost:3000
API_VERSION=v1

# Authentication
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRY=24h
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here_min_32_chars
REFRESH_TOKEN_EXPIRY=7d

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Session
SESSION_SECRET=your_session_secret_here_min_32_chars
SESSION_MAX_AGE=86400000

# Payment Gateway - QRIS
QRIS_MERCHANT_ID=your_merchant_id
QRIS_API_KEY=your_qris_api_key
QRIS_SECRET_KEY=your_qris_secret_key
QRIS_WEBHOOK_SECRET=your_qris_webhook_secret

# Payment Gateway - Bank Transfer
BANK_TRANSFER_ENABLED=true
BANK_API_KEY=your_bank_api_key
BANK_SECRET_KEY=your_bank_secret_key

# SMS/WhatsApp Notification
WHATSAPP_ENABLED=true
WHATSAPP_API_KEY=your_whatsapp_api_key
WHATSAPP_PHONE_NUMBER=62812345678
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@laundryenterprise.com

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=10mb
LOG_MAX_FILES=14

# Cache
CACHE_ENABLED=true
CACHE_TTL=3600
REDIS_URL=redis://localhost:6379

# Multi-Tenant
MULTI_TENANT_ENABLED=true
TENANT_ISOLATION=database

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_SERVICE=google

# Feature Flags
FEATURE_LOYALTY_PROGRAM=true
FEATURE_PICKUP_DELIVERY=true
FEATURE_BULK_OPERATIONS=true
FEATURE_EXPORT_REPORTS=true
FEATURE_INVENTORY_TRACKING=true
FEATURE_STAFF_SCHEDULING=true

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Date & Time
TIMEZONE=Asia/Jakarta
DATE_FORMAT=DD/MM/YYYY
TIME_FORMAT=HH:mm:ss

# Business Rules
MIN_ORDER_WEIGHT=0.5
MAX_ORDER_WEIGHT=100
LOYALTY_POINTS_MULTIPLIER=1
LOYALTY_POINTS_REDEMPTION_RATIO=1000

# Security
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
ALLOWED_IP_ADDRESSES=
IP_WHITELIST_ENABLED=false

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_DESTINATION=./backups

# Monitoring
SENTRY_ENABLED=false
SENTRY_DSN=
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=60000

# Development Tools
DEBUG=laundry:*
MOCK_DATA_ENABLED=false
SEED_DATABASE=false