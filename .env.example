# Database
DATABASE_URL=file:local.db

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# API Configuration
API_PREFIX=/api
API_TIMEOUT=30000
MAX_REQUEST_SIZE=50mb

# Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRY=7d
REFRESH_TOKEN_EXPIRY=30d

# Session
SESSION_SECRET=your_session_secret_key_change_in_production
SESSION_TIMEOUT=3600000

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Pagination
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@laundry-enterprise.com

# Payment Gateway - QRIS
QRIS_API_KEY=your_qris_api_key
QRIS_API_URL=https://api.qris-provider.com
QRIS_MERCHANT_ID=your_merchant_id

# Payment Gateway - Bank Transfer
BANK_TRANSFER_ENABLED=true
BANK_ACCOUNT_NAME=PT Laundry Enterprise
BANK_ACCOUNT_NUMBER=1234567890
BANK_CODE=bca

# SMS/WhatsApp Integration
WHATSAPP_API_KEY=your_whatsapp_api_key
WHATSAPP_PHONE_NUMBER=62812345678
WHATSAPP_ENABLED=false

# Google Maps Integration (for delivery tracking)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_PROVIDER=mixpanel

# Redis Cache (optional)
REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Multi-Tenant Configuration
TENANT_MODE=multi
TENANT_SEPARATOR=.

# Security
BCRYPT_ROUNDS=10
PASSWORD_MIN_LENGTH=8
ALLOW_REGISTRATION=true

# Logging
LOG_DIR=./logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14d

# Features
FEATURE_LOYALTY_PROGRAM=true
FEATURE_DELIVERY_TRACKING=true
FEATURE_MACHINE_MAINTENANCE=true
FEATURE_STAFF_SCHEDULING=true
FEATURE_INVENTORY_TRACKING=true

# Report Generation
REPORT_FORMAT=pdf
REPORT_DIR=./reports

# Timezone
TZ=Asia/Jakarta

# Application Name
APP_NAME=Aplikasi Laundry Enterprise
APP_VERSION=1.0.0
APP_DOMAIN=laundry_enterprise

# Color Scheme
PRIMARY_COLOR=#3B82F6
SECONDARY_COLOR=#10B981