# Database
DATABASE_URL=file:./dev.db

# Server
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# Authentication
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# QRIS Payment
QRIS_MERCHANT_ID=your_qris_merchant_id
QRIS_API_KEY=your_qris_api_key
QRIS_API_URL=https://api.qris.example.com

# Bank Transfer
BANK_API_KEY=your_bank_api_key
BANK_API_URL=https://api.bank.example.com

# SMS Notification
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@laundry.com

# AWS S3 (Optional - for invoice/receipt storage)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=laundry-enterprise-bucket

# WhatsApp Integration (Optional)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_API_TOKEN=your_whatsapp_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Multi-tenant
TENANT_ID=default
TENANT_NAME=Laundry Enterprise

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=90

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Feature Flags
FEATURE_LOYALTY_POINTS=true
FEATURE_MULTI_BRANCH=true
FEATURE_DELIVERY_TRACKING=true
FEATURE_INVOICE_GENERATION=true
FEATURE_ANALYTICS=true