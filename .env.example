# Database
DATABASE_URL=file:dev.db
TURSO_CONNECTION_URL=libsql://your-db-name-xxxx.turso.io
TURSO_AUTH_TOKEN=your_auth_token_here

# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# API Keys
QRIS_API_KEY=your_qris_api_key_here
QRIS_MERCHANT_ID=your_qris_merchant_id_here
BANK_TRANSFER_API_KEY=your_bank_transfer_api_key_here

# Payment Gateway
PAYMENT_GATEWAY_URL=https://api.payment-gateway.com
PAYMENT_CALLBACK_SECRET=your_payment_callback_secret_here

# SMS/Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=noreply@laundryenterprise.com
SMTP_FROM_NAME=Laundry Enterprise

# WhatsApp Integration (Optional)
WHATSAPP_API_URL=https://api.whatsapp.com
WHATSAPP_API_TOKEN=your_whatsapp_api_token_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRES_IN=30d

# Session
SESSION_SECRET=your_session_secret_key_here
SESSION_TIMEOUT=1800000

# Encryption
ENCRYPTION_KEY=your_32_character_encryption_key_here
ENCRYPTION_IV=your_16_character_iv_here

# Business Settings
CURRENCY=IDR
BUSINESS_NAME=Laundry Enterprise
TIMEZONE=Asia/Jakarta
DEFAULT_LANGUAGE=id

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_SERVICE_URL=https://analytics.example.com
ANALYTICS_API_KEY=your_analytics_api_key_here

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,xlsx,xls,csv

# Report Generation
REPORT_OUTPUT_DIR=reports
REPORT_RETENTION_DAYS=30

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=backups

# Feature Flags
FEATURE_LOYALTY_POINTS=true
FEATURE_SMS_NOTIFICATION=true
FEATURE_EMAIL_NOTIFICATION=true
FEATURE_WHATSAPP_NOTIFICATION=false
FEATURE_INVENTORY_MANAGEMENT=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_MULTI_CURRENCY=false

# Admin Settings
ADMIN_EMAIL=admin@laundryenterprise.com
ADMIN_PHONE=+62812345678
SUPPORT_EMAIL=support@laundryenterprise.com

# API Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=/api-docs

# Security
HELMET_ENABLED=true
ALLOW_PROXY=true