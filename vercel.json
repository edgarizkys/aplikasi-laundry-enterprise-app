{
  "version": 2,
  "builds": [
    {
      "src": "src/app.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "src/app.js"
    },
    {
      "src": "/static/(.*)",
      "dest": "/public/static/$1"
    },
    {
      "src": "/(.*\\.(?:css|js|jpg|jpeg|png|gif|ico|svg|webp|woff|woff2))",
      "dest": "/public/$1"
    },
    {
      "src": "/(?!api).*",
      "dest": "/public/index.html"
    }
  ],
  "env": [
    {
      "key": "PORT",
      "value": "3000"
    },
    {
      "key": "NODE_ENV",
      "value": "production"
    }
  ],
  "functions": {
    "src/app.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}